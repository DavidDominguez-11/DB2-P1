# Parametric Grill Hub — Variables de Entorno
# Copia este archivo como .env y configura tu URI de MongoDB Atlas

# MongoDB Atlas (reemplaza con tu connection string)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Para MongoDB local:
# MONGO_URI=mongodb://localhost:27017/

DB_NAME=parametric_grill_hub
